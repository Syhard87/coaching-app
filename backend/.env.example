# Copier ce fichier en .env et renseigner les vraies valeurs (jamais commit .env)

# URL de connexion PostgreSQL (Neon). Récupérée depuis le dashboard Neon,
# projet > Connection Details > Prisma. Garder "?sslmode=require".
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Port d'écoute du serveur Express en local
PORT=3001

# Clé secrète de signature des JWT (générer une valeur aléatoire longue en production,
# ex. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET="change-me"

# URL du frontend déployé (Netlify), pour restreindre le CORS en production.
# Laisser absent en local : toutes les origines sont alors acceptées.
# FRONTEND_URL="https://mon-app.netlify.app"

# Identifiants OAuth2 Google (Google Cloud Console > APIs & Services > Identifiants).
# Voir cahier des charges section 7 / TASKS.md Phase 9.5.
GOOGLE_CLIENT_ID="votre-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="votre-client-secret"

# URL de callback enregistrée dans la Google Cloud Console (URI de redirection autorisée).
# Laisser absent en local : http://localhost:3001/api/auth/google/callback est utilisé par défaut.
# GOOGLE_CALLBACK_URL="https://mon-backend.onrender.com/api/auth/google/callback"
