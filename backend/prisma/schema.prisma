// Schéma de données — voir docs/cahier-des-charges.md section 4 pour le modèle indicatif
// et section 3 pour le détail fonctionnel de chaque entité.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---------------------------------------------------------------

enum Sexe {
  HOMME
  FEMME
}

enum ObjectifClient {
  PRISE_DE_MASSE
  PERTE_DE_POIDS
  REMISE_EN_FORME
  PERFORMANCE
}

// Facteurs d'activité — cahier des charges section 3.2
enum NiveauActivite {
  SEDENTAIRE
  LEGEREMENT_ACTIF
  MODEREMENT_ACTIF
  TRES_ACTIF
  EXTREMEMENT_ACTIF
}

enum HoraireTravail {
  BUREAU
  POSTE_3X8
  IRREGULIER
  AUTRE
}

enum ExperienceSportive {
  DEBUTANT
  INTERMEDIAIRE
  CONFIRME
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

enum Creneau {
  MATIN
  MIDI
  SOIR
}

// Types de split — cahier des charges section 3.3
enum TypeSplit {
  FULL_BODY
  HALF_BODY
  PPL
  BRO_SPLIT
  PERSONNALISE
}

enum StatutSemaine {
  NORMALE
  DELOAD
  TEST
}

enum MethodeCalcul {
  AUTO
  MANUEL
}

// Objectif calorique — cahier des charges section 3.2 étape 3
enum TypeObjectifCalorique {
  DEFICIT_LEGER
  DEFICIT_MODERE
  SURPLUS_LEGER
  SURPLUS_MODERE
  MAINTIEN
}

// Pipeline de prospection — cahier des charges section 3.10
enum StatutProspect {
  NOUVEAU
  CONTACTE
  CONVERTI
  PERDU
}

// Abonnements par module — cahier des charges section 5 (Phase 10)
enum ModuleAbonnement {
  SPORT
  DIETE
  PACK_COMPLET
}

// Planning & réservation — cahier des charges section 5 (Phase 11)
enum StatutReservation {
  CONFIRMEE
  ANNULEE
  HONOREE
}

// --- Modèles ---------------------------------------------------------------

model Coach {
  id             String   @id @default(cuid())
  nom            String
  email          String   @unique
  // Authentification email/mot de passe remplacée par Google OAuth2 (cahier des charges
  // section 7 / Phase 9.5) : plus obligatoire, conservé nullable pour ne pas perdre les
  // comptes créés avant la migration.
  motDePasseHash String?
  googleId       String?  @unique
  avatarUrl      String?
  // Slug public utilisé par la page de prospection sans authentification (/p/:slug) —
  // dérivé du nom à la création, modifiable ensuite dans le profil. Cahier des charges section 3.10.
  slug           String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clients              Client[]
  templatesProgramme   TemplateProgramme[]
  prospects            Prospect[]
  catalogueAbonnements CatalogueAbonnement[]
  creneauxDisponibles  CreneauDisponible[]

  @@map("coaches")
}

// Créneau déclaré disponible par le coach — récurrent (jour de semaine type) ou ponctuel
// (date précise). heureDebut/heureFin au format "HH:mm" (comparaison lexicographique fiable
// sur des chaînes zero-paddées, pas de fuseau à gérer). Cahier des charges section 5 (T11.1).
model CreneauDisponible {
  id          String       @id @default(cuid())
  coachId     String
  coach       Coach        @relation(fields: [coachId], references: [id], onDelete: Cascade)
  recurrent   Boolean      @default(true)
  jourSemaine JourSemaine? // requis si récurrent
  date        DateTime?    // requis si ponctuel (recurrent = false)
  heureDebut  String
  heureFin    String
  createdAt   DateTime     @default(now())

  reservations Reservation[]

  @@map("creneaux_disponibles")
}

// Réservation d'un client sur un créneau — le coach réserve en son nom en attendant un
// espace client (T11.3). dateHeure porte la date/heure concrète de cette occurrence
// (un créneau récurrent peut être réservé sur plusieurs dates différentes).
model Reservation {
  id        String            @id @default(cuid())
  clientId  String
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creneauId String?
  // SetNull plutôt que Cascade : supprimer un créneau modèle ne doit pas effacer
  // l'historique réel des réservations déjà prises dessus.
  creneau   CreneauDisponible? @relation(fields: [creneauId], references: [id], onDelete: SetNull)

  dateHeure DateTime
  statut    StatutReservation @default(CONFIRMEE)
  createdAt DateTime          @default(now())

  @@map("reservations")
}

// Catalogue éditable par le coach (module, durée, prix) — cahier des charges section 5.
// Grille par défaut créée à l'inscription (T10.1) : Sport/Diète 50€/120€/180€, Pack Complet 85€/200€/300€.
model CatalogueAbonnement {
  id        String           @id @default(cuid())
  coachId   String
  coach     Coach            @relation(fields: [coachId], references: [id], onDelete: Cascade)
  module    ModuleAbonnement
  dureeMois Int
  prixTotal Float
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  clientAbonnements ClientAbonnement[]

  @@map("catalogue_abonnements")
}

// Abonnement vendu à un client — dateFin calculée automatiquement à la vente
// (dateDebut + dureeMois du catalogue). Un module est actif tant qu'un abonnement
// non expiré le couvre (voir lib/accesModules.js — T10.3).
model ClientAbonnement {
  id                    String              @id @default(cuid())
  clientId              String
  client                Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  catalogueAbonnementId String
  catalogueAbonnement   CatalogueAbonnement @relation(fields: [catalogueAbonnementId], references: [id])
  dateDebut             DateTime            @default(now())
  dateFin               DateTime
  createdAt             DateTime            @default(now())

  @@map("client_abonnements")
}

model Client {
  id      String @id @default(cuid())
  coachId String
  coach   Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  nom          String
  age          Int?
  sexe         Sexe?
  tailleCm     Float?
  poidsInitial Float?
  objectif     ObjectifClient
  dateDebut    DateTime       @default(now())
  notesSante   String?
  suiviMedical Boolean        @default(false)

  niveauActivite     NiveauActivite?
  profession         String?
  horaireTravail     HoraireTravail?
  experienceSportive ExperienceSportive?

  archive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disponibilites     Disponibilite[]
  programmes         Programme[]
  seances            Seance[]
  objectifDiete      ObjectifDiete?
  journalDiete       JournalDiete[]
  mesures            Mesure[]
  prospectsConvertis Prospect[]
  abonnements        ClientAbonnement[]
  reservations       Reservation[]

  @@map("clients")
}

model Disponibilite {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  jourSemaine JourSemaine
  creneau     Creneau
  disponible  Boolean     @default(true)

  @@unique([clientId, jourSemaine, creneau])
  @@map("disponibilites")
}

model Programme {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  nom       String
  typeSplit TypeSplit
  frequence Int
  version   Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycles Cycle[]
  jours  JourEntrainement[]

  @@map("programmes")
}

model Cycle {
  id          String    @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  nom           String
  ordre         Int
  dureeSemaines Int
  // Date de début du cycle — sert à calculer quelle semaine planifiée correspond à
  // "aujourd'hui" (tableau de bord T6.1). Optionnelle : un cycle créé sans date de
  // démarrage explicite n'est simplement jamais compté comme "en cours" cette semaine.
  dateDebut     DateTime? @default(now())

  semaines SemainePlanifiee[]

  @@map("cycles")
}

model SemainePlanifiee {
  id      String @id @default(cuid())
  cycleId String
  cycle   Cycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  numeroSemaine Int
  statut        StatutSemaine @default(NORMALE)
  notes         String?

  jours JourEntrainement[]

  @@map("semaines_planifiees")
}

// Un jour d'entraînement appartient soit directement au programme (jour "modèle",
// répété chaque semaine du cycle), soit à une semaine précise si le coach veut
// personnaliser cette semaine-là (ex. charge cible modifiée pour une semaine de deload).
model JourEntrainement {
  id          String            @id @default(cuid())
  programmeId String?
  programme   Programme?        @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  semaineId   String?
  semaine     SemainePlanifiee? @relation(fields: [semaineId], references: [id], onDelete: Cascade)

  nom   String
  ordre Int

  exercices ExerciceProgramme[]
  seances   Seance[]

  @@map("jours_entrainement")
}

model ExerciceProgramme {
  id     String           @id @default(cuid())
  jourId String
  jour   JourEntrainement @relation(fields: [jourId], references: [id], onDelete: Cascade)

  nom         String
  series      Int
  reps        String
  chargeCible Float?
  tempsRepos  Int?
  notes       String?
  lienVideo   String?

  @@map("exercices_programme")
}

model Seance {
  id       String            @id @default(cuid())
  clientId String
  client   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jourId   String?
  jour     JourEntrainement? @relation(fields: [jourId], references: [id], onDelete: SetNull)

  date     DateTime @default(now())
  ressenti Int?
  notes    String?

  exercicesRealises ExerciceRealise[]

  @@map("seances")
}

model ExerciceRealise {
  id       String @id @default(cuid())
  seanceId String
  seance   Seance @relation(fields: [seanceId], references: [id], onDelete: Cascade)

  nom            String
  chargeRealisee Float?
  repsRealisees  String?
  notes          String?

  @@map("exercices_realises")
}

model ObjectifDiete {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  methodeCalcul         MethodeCalcul          @default(AUTO)
  tdeeCalcule           Float?
  typeObjectifCalorique TypeObjectifCalorique?
  caloriesCible         Int
  proteinesCible        Int
  glucidesCible         Int
  lipidesCible          Int

  // Traçabilité du calcul automatique (T11.5.2/T11.5.4/T11.5.5) : le poids et la date de la
  // mesure réellement utilisés — la dernière entrée de `mesures`, jamais poidsInitial une fois
  // qu'au moins une mesure existe. Null en mode manuel, ou si aucune mesure n'existe encore
  // (repli sur poidsInitial : dateMesureUtilisee reste null dans ce cas précis).
  poidsUtilise      Float?
  dateMesureUtilisee DateTime?

  updatedAt DateTime @updatedAt

  @@map("objectifs_diete")
}

model JournalDiete {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  date      DateTime @default(now())
  calories  Int?
  proteines Int?
  glucides  Int?
  lipides   Int?
  eau       Float?
  repas     String?
  notes     String?

  @@unique([clientId, date])
  @@map("journal_diete")
}

model Mesure {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  date     DateTime @default(now())
  poids    Float?
  bras     Float?
  taille   Float?
  poitrine Float?
  cuisse   Float?
  notes    String?

  @@map("mesures")
}

model TemplateProgramme {
  id      String @id @default(cuid())
  coachId String
  coach   Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  nom         String
  typeSplit   TypeSplit
  contenuJson Json

  createdAt DateTime @default(now())

  @@map("templates_programme")
}

// Demande reçue hors app (Instagram, bouche-à-oreille...) via la page publique du coach
// (/p/:slug, sans authentification) — cahier des charges section 3.10.
model Prospect {
  id      String @id @default(cuid())
  coachId String
  coach   Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  nom      String
  contact  String
  objectif String?
  message  String?
  statut   StatutProspect @default(NOUVEAU)

  // Renseigné une fois le prospect converti en client (US-8.3) ; le prospect reste
  // visible dans l'historique même après conversion ou suppression du client.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  dateCreation DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("prospects")
}
